* text=auto eol=lf

# Windows executables MUST stay CRLF: cmd.exe misparses LF-only .bat files,
# and PowerShell 5.1 is safest with CRLF. Critical for fresh git clones.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
