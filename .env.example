APP_NAME=HRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

ATTENDANCE_PUSH_RATE_LIMIT=60
ATTENDANCE_PUSH_UNLIMITED_IPS=127.0.0.1,::1
ATTENDANCE_BIODATA_DEBUG_SNAPSHOTS=false
# Punch-ingestion queue (morning/evening bursts). Consumed by the
# `attendance` workers in scripts/Start-HRM-Windows.ps1 — device_commands flows untouched.
ATTENDANCE_QUEUE=attendance
ATTENDANCE_QUEUE_CHUNK=100
BIODATA_LOG_LEVEL=warning
BIODATA_LOG_DAYS=14
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue retry — must be > longest job timeout (AttendanceIngestionJob:180s)
DB_QUEUE_RETRY_AFTER=610
DB_QUEUE_AFTER_COMMIT=true
REDIS_QUEUE_RETRY_AFTER=610
REDIS_QUEUE_AFTER_COMMIT=true

# Database tuning
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_STICKY=true

# Logging
ATTENDANCE_PUSH_LOG_LEVEL=warning
ATTENDANCE_PUSH_LOG_DAYS=14

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ZKTeco Bridge & ADMS Unification (ADMS-first)
ZKTECO_BRIDGE_URL=http://127.0.0.1:5000
ZKTECO_BRIDGE_TIMEOUT=300
PULL_FINGERPRINTS_VIA=adms
PUSH_USER_VIA=adms

# Database Backup & Restore
BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Damascus
BACKUP_DATABASE_CONNECTION=mysql
BACKUP_DATABASE_NAME=hrmair
BACKUP_MYSQLDUMP_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe
BACKUP_MYSQL_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysql.exe
BACKUP_LOCAL_DISK=backups
BACKUP_REMOTE_DISK=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=
BACKUP_VERIFICATION_ENABLED=true
BACKUP_MIN_FREE_SPACE_MB=20480
BACKUP_RESTORE_TEST_DATABASE_PREFIX=hrmair_restore_test_
BACKUP_LOG_LEVEL=info
BACKUP_LOG_DAYS=90
